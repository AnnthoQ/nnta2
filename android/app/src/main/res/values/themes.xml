<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Remote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/bg</item>
        <item name="android:colorPrimaryDark">@color/bg</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorControlActivated">@color/blue</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/label2</item>
        <item name="android:textColorHint">@color/label3</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Title">
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">34sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Body">
        <item name="android:textColor">@color/label2</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Section">
        <item name="android:textColor">@color/label2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="FieldLabel">
        <item name="android:textColor">@color/label2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>

    <style name="Field">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textColorHint">@color/label3</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
    </style>

    <style name="Btn.Primary">
        <item name="android:background">@drawable/bg_btn_primary</item>
    </style>

    <style name="Btn.Danger">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="Link">
        <item name="android:textColor">@color/blue</item>
        <item name="android:textSize">16sp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>

    <style name="Step">
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>
