<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/back"
            style="@style/Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="-6dp"
            android:drawableStart="@drawable/ic_back"
            android:drawablePadding="2dp"
            android:drawableTint="@color/blue"
            android:gravity="center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="10dp"
            android:text="@string/back"
            android:textSize="17sp" />

        <TextView
            style="@style/Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/help_title" />

        <TextView
            style="@style/Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help_intro" />

        <TextView
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/label3"
            android:textSize="14sp" />

        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/checkBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/checkNotif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 1 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s1_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s1" />

            <Button
                android:id="@+id/openStartup"
                style="@style/Btn.Primary"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/help_s1_btn" />
        </LinearLayout>

        <!-- 2 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s2_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s2" />

            <Button
                android:id="@+id/openExempt"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/help_s2_btn" />
        </LinearLayout>

        <!-- 3 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s3_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s3" />

            <Button
                android:id="@+id/openBattery"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/help_s3_btn" />
        </LinearLayout>

        <!-- 4 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s4_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s4" />

            <Button
                android:id="@+id/openNotif"
                style="@style/Btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="14dp"
                android:text="@string/help_s4_btn" />
        </LinearLayout>

        <!-- 5 -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s5_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s5" />
        </LinearLayout>

        <!-- Prueba -->
        <LinearLayout
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s6_title"
                android:textColor="@color/label"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Step"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_s6" />
        </LinearLayout>

        <Button
            android:id="@+id/openApp"
            style="@style/Btn"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="@string/help_app_btn" />
    </LinearLayout>
</ScrollView>
